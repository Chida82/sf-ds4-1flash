index 0000000..95b09ac
--- /dev/null
+++ b/sysone-bench/schema_first.py
@@ -0,0 +1,90 @@
+#!/usr/bin/env python3
+"""schema_first against state_first on the same items (change a015, step 3).
+
+    schema_first.py --rows sf.tsv --items A.jsonl ... --base r-sys.jsonl ...
+
+`sf.tsv` is written by `tests/test_sysone MODEL --schema-first`: id, schema
+(hit|miss), top, legal mass, schema ms, state ms, question ms, state tokens,
+pointer tokens, option logits. `--base` are the `a010` state_first rows of the
+same items. Prints accuracy of both with the paired bootstrap interval of the
+difference, the latency per decision (schema hits only) and the design's rule.
+"""
+import argparse
+import json
+import random
+
+import metrics
+from run import label_key, load_items, option_keys
+
+
+def read_rows(path):
+    out = {}
+    for line in open(path):
+        f = line.rstrip("\n").split("\t")
+        out[f[0]] = {"kind": f[1], "mass": float(f[3]), "schema_ms": float(f[4]), "state_ms": float(f[5]),
+                     "q_ms": float(f[6]), "logits": [float(x) for x in f[9].split(",")]}
+    return out
+
+
+def paired_diff(pairs, n=2000, seed=0):
+    """95% interval of mean(b - a) over (a, b) correctness pairs, resampling items."""
+    rng = random.Random(seed)
+    k = len(pairs)
+    d = sorted(sum(b - a for a, b in (pairs[rng.randrange(k)] for _ in range(k))) / k for _ in range(n))
+    return d[int(0.025 * n)], d[int(0.975 * n) - 1]
+
+
+def compare(rows, items, base):
+    pairs, sf_ms, st_ms, mass = [], [], [], []
+    for it in items:
+        i = it["id"].replace(" ", "_")
+        if i not in rows or it["id"] not in base or not base[it["id"]].get("probs"):
+            continue
+        r, b = rows[i], base[it["id"]]
+        keys = option_keys(it["question"])
+        top_sf = keys[max(range(len(keys)), key=lambda k: r["logits"][k])]
+        lab = label_key(it)
+        pairs.append((int(metrics.top(b["probs"]) == lab), int(top_sf == lab)))
+        mass.append(r["mass"])
+        if r["kind"] == "hit":
+            sf_ms.append(r["schema_ms"] + r["state_ms"] + r["q_ms"])
+            st_ms.append(b["ms"])
+    return pairs, sf_ms, st_ms, mass
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("--rows", required=True)
+    ap.add_argument("--items", nargs="+", required=True)
+    ap.add_argument("--base", nargs="+", required=True)
+    a = ap.parse_args()
+    rows = read_rows(a.rows)
+    items = [it for p in a.items for it in load_items(p)]
+    base = {r["id"]: r for p in a.base for r in map(json.loads, open(p))}
+    by = {}
+    for it in items:
+        by.setdefault(it.get("workflow", "?"), []).append(it)
+    print("| set | n | state_first | schema_first | difference (95% CI) | mass mean | p50 ms state_first | p50 ms schema_first (hits) |")
+    print("|---|---|---|---|---|---|---|---|")
+    allp, alls, allt = [], [], []
+    for name, its in sorted(by.items()) + [("all", items)]:
+        pairs, sf_ms, st_ms, mass = compare(rows, its, base)
+        if not pairs:
+            continue
+        lo, hi = paired_diff(pairs)
+        n = len(pairs)
+        print(f"| {name} | {n} | {sum(p[0] for p in pairs) / n:.3f} | {sum(p[1] for p in pairs) / n:.3f} | "
+              f"{(sum(p[1] - p[0] for p in pairs)) / n:+.3f} ({lo:+.3f} to {hi:+.3f}) | {sum(mass) / n:.4f} | "
+              f"{metrics.percentile(sorted(st_ms), 0.5):.0f} | {metrics.percentile(sorted(sf_ms), 0.5):.0f} |")
+        if name == "all":
+            allp, alls, allt = pairs, sf_ms, st_ms
+    _, hi = paired_diff(allp)
+    level = hi >= -0.010  # the interval does not lie wholly below -1 point
+    fast = metrics.percentile(sorted(alls), 0.5) <= 0.5 * metrics.percentile(sorted(allt), 0.5)
+    print(f"\nrule: difference interval not wholly below -0.010: {'ok' if level else 'FAIL'}; "
+          f"p50 latency at most half: {'ok' if fast else 'FAIL'} -> {'KEEP' if level and fast else 'DROP'}")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
