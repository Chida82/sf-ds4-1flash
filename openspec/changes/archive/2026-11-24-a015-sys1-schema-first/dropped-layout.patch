+/* ---- a015: schema_first ---- */
+
+static const char SYS2[] =
+    "You are a decision function. Several questions are defined below, then a state. "
+    "For the question you are asked about, choose exactly one of its listed options.";
+
+void sf_sysone_schema_prefix(sf_sysone *so, const sf_sysone_question *q, int n, ds4_tokens *out) {
+    ds4_chat_begin(so->e, out);
+    ds4_chat_append_message(so->e, out, "system", SYS2);
+    ds4_tokens_push(out, ds4_token_user(so->e));
+    char *text = NULL, head[32];
+    size_t len = 0, cap = 0;
+    text_add(&text, &len, &cap, "Questions:\n");
+    for (int k = 0; k < n; k++) {
+        snprintf(head, sizeof(head), "Q%d: ", k + 1);
+        text_add(&text, &len, &cap, head);
+        text_add(&text, &len, &cap, q[k].instructions);
+        text_add(&text, &len, &cap, "\n");
+        for (int i = 0; i < q[k].n_options; i++) {
+            char *line = option_line(&q[k], i);
+            text_add(&text, &len, &cap, line);
+            free(line);
+        }
+        text_add(&text, &len, &cap, "\n");
+    }
+    ds4_tokenize_text(so->e, text, out);
+    free(text);
+}
+
+void sf_sysone_schema_state(sf_sysone *so, const char *state, ds4_tokens *out) {
+    ds4_tokenize_text(so->e, "State:\n", out);
+    ds4_tokenize_text(so->e, state, out);
+}
+
+void sf_sysone_pointer_suffix(sf_sysone *so, int index1, ds4_tokens *out) {
+    char text[64];
+    snprintf(text, sizeof(text), "\n\nAnswer Q%d with the identifier only.", index1);
+    ds4_tokenize_text(so->e, text, out);
+    ds4_chat_append_assistant_prefix(so->e, out, DS4_THINK_NONE);
+}
+
 char *sf_sysone_turn_text(const sf_sysone_question *q) {
     size_t cap = strlen(q->instructions) + 160, len = 0;
     char *out = malloc(cap);
