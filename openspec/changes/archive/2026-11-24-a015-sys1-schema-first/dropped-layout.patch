+/* ---- a015: schema_first measured on a stream of states sharing one question ---- */
+
+/* One item of the trajectory.py format; fields owned by the caller (item_free). */
+typedef struct {
+    char id[256], typ[16];
+    int n;
+    char *state, *instr, *names[SF_SYSONE_MAX_OPTIONS], *texts[SF_SYSONE_MAX_OPTIONS];
+    sf_sysone_question q;
+} item_in;
+
+static int item_read(FILE *f, item_in *it) {
+    memset(it, 0, sizeof(*it));
+    if (fscanf(f, "%255s %15s %d\n", it->id, it->typ, &it->n) != 3 || it->n < 1 || it->n > SF_SYSONE_MAX_OPTIONS) return 0;
+    it->state = read_field(f);
+    it->instr = read_field(f);
+    for (int i = 0; i < it->n; i++) it->names[i] = read_field(f);
+    for (int i = 0; i < it->n; i++) it->texts[i] = read_field(f);
+    it->q = (sf_sysone_question){!strcmp(it->typ, "noul") ? SF_SYSONE_NOUL : !strcmp(it->typ, "score") ? SF_SYSONE_SCORE
+                                : SF_SYSONE_CHOICE, it->instr, it->n, (const char *const *)it->names, (const char *const *)it->texts};
+    return it->state && it->instr;
+}
+
+static void item_free(item_in *it) {
+    free(it->state); free(it->instr);
+    for (int i = 0; i < it->n; i++) { free(it->names[i]); free(it->texts[i]); }
+}
+
+static int same_question(const item_in *a, const item_in *b) {
+    if (a->n != b->n || strcmp(a->typ, b->typ) || strcmp(a->instr, b->instr)) return 0;
+    for (int i = 0; i < a->n; i++)
+        if (strcmp(a->names[i], b->names[i]) || strcmp(a->texts[i], b->texts[i])) return 0;
+    return 1;
+}
+
+static int mode_schema_first(const char *items_path, const char *out_path) {
+    char err[1024] = {0};
+    FILE *f = fopen(items_path, "rb"), *out = fopen(out_path, "w");
+    if (!f || !out) { fprintf(stderr, "schema-first: cannot open files\n"); return 1; }
+    item_in cur = {0}, it;
+    int have = 0, n_items = 0, rc = 0;
+    ds4_tokens schema = {0}, prefix = {0}, pointer = {0};
+    ds4_session_snapshot snap = {0};
+    sf_sysone_answer a;
+    sf_sysone_pointer_suffix(so, 1, &pointer);
+    while (!rc && item_read(f, &it)) {
+        const double t0 = now_ms();
+        const char *kind = "hit";
+        if (!have || !same_question(&cur, &it)) {  /* a new schema: prefill it and keep a snapshot */
+            if (have) item_free(&cur);
+            cur = it;
+            have = 1;
+            schema.len = 0;
+            sf_sysone_schema_prefix(so, &cur.q, 1, &schema);
+            ds4_session_snapshot_free(&snap);
+            rc = ds4_session_sync(session, &schema, err, sizeof(err));
+            if (!rc) rc = ds4_session_save_snapshot(session, &snap, err, sizeof(err));
+            kind = "miss";
+        } else {
+            rc = ds4_session_load_snapshot(session, &snap, err, sizeof(err));
+        }
+        const double t1 = now_ms();
+        prefix.len = 0;
+        ds4_tokens_copy(&prefix, &schema);
+        sf_sysone_schema_state(so, it.state, &prefix);
+        if (!rc) rc = ds4_session_sync(session, &prefix, err, sizeof(err));
+        const double t2 = now_ms();
+        if (!rc) rc = sf_sysone_answer_suffixes(so, session, &prefix, NULL, &it.q, 1, &pointer, NULL, &a, err, sizeof(err), NULL);
+        if (!rc) {
+            fprintf(out, "%s\t%s\t%d\t%.6f\t%.1f\t%.1f\t%.1f\t%d\t%d\t", it.id, kind, a.top, a.legal_mass,
+                    t1 - t0, t2 - t1, a.ms, prefix.len - schema.len, a.suffix_tokens);
+            for (int i = 0; i < a.n_options; i++) fprintf(out, "%s%.6f", i ? "," : "", a.logit[i]);
+            fprintf(out, "\n");
+            fflush(out);
+            fprintf(stderr, "schema-first: %d %s %s %.0f ms\n", ++n_items, it.id, kind, now_ms() - t0);
+        } else fprintf(stderr, "schema-first: %s: %s\n", it.id, err);
+        if (cur.state != it.state) item_free(&it);
+    }
+    if (have) item_free(&cur);
+    ds4_session_snapshot_free(&snap);
+    ds4_tokens_free(&schema); ds4_tokens_free(&prefix); ds4_tokens_free(&pointer);
+    fclose(f); fclose(out);
+    check(n_items > 0 && !rc, "schema-first rows written");
+    return rc;
+}
