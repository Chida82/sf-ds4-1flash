#!/bin/sh
# sfctl: run StarForge models as on-demand launchd services.
#
# The same script ships in every child; only sfctl/sf-<model>.conf differs.
# Each service runs from its own serve worktree, ~/.sf/<model>/serve, detached
# at the child's local main. Nothing starts at login or restarts on exit.
# Agents: read sfctl/README.md before running install, update or uninstall.
set -eu

LA="$HOME/Library/LaunchAgents"
LOGS="$HOME/Library/Logs/sf"
CMD_LINK="$HOME/.local/bin/sfctl"
DOMAIN="gui/$(id -u)"
FANBOOST=/usr/local/bin/fanboost

# The directory holding this script, through the ~/.local/bin link.
self=$0
while [ -L "$self" ]; do
    t=$(readlink "$self")
    case $t in
        /*) self=$t ;;
        *) self=$(dirname "$self")/$t ;;
    esac
done
SFDIR=$(cd "$(dirname "$self")" && pwd -P)

usage() {
    cat >&2 <<'EOF'
usage: sfctl <command> [<model>]

  install [<model>]   run from a child checkout: serve worktree at main, build,
                      model links, launchd agent, ~/.local/bin/sfctl
  update <model>      sync serve to local main and rebuild; a running service
                      is restarted, a stopped one stays stopped
  start <model>       start the service (it never starts on its own)
  stop <model>        stop the service
  restart <model>     stop, then start
  status [<model>]    state, pid, port and serve commit; every installed model
                      when no model is named
  logs <model> [N]    last N lines of the service log (default 80)
  follow <model>      follow the service log
  plist <model>       print the launchd agent definition, write nothing
  uninstall <model>   remove the agent and serve; keep KV, logs and models

<model> is the child's name without "sf-": ds4-1flash runs sf-ds4-1flash.
EOF
    exit 2
}

die() {
    echo "sfctl: $*" >&2
    exit 1
}

label() { echo "com.starforge.sf-$1"; }
target() { echo "$DOMAIN/$(label "$1")"; }
plist_path() { echo "$LA/$(label "$1").plist"; }
home_dir() { echo "$HOME/.sf/$1"; }
serve_dir() { echo "$HOME/.sf/$1/serve"; }

installed_models() {
    for f in "$LA"/com.starforge.sf-*.plist; do
        [ -e "$f" ] || continue
        n=${f##*/com.starforge.sf-}
        echo "${n%.plist}"
    done
}

running_models() {
    for m in $(installed_models); do
        [ -n "$(pid "$m")" ] && echo "$m"
    done
    return 0
}

pid() {
    launchctl print "$(target "$1")" 2>/dev/null |
        awk '$1 == "pid" && $2 == "=" { print $3; exit }'
}

loaded() { launchctl print "$(target "$1")" >/dev/null 2>&1; }

need_model() {
    # $1 command, $2 model (may be empty)
    if [ -z "$2" ]; then
        running=$(running_models | tr '\n' ' ')
        echo "sfctl: $1 needs a model${running:+ (running: ${running% })}" >&2
        usage
    fi
}

need_installed() {
    [ -e "$(plist_path "$1")" ] ||
        die "$1 is not installed (run sfctl install from the sf-$1 checkout)"
}

# Sources sf-<model>.conf from <dir>/sfctl.
load_conf() {
    conf="$2/sfctl/sf-$1.conf"
    [ -f "$conf" ] || die "no config for $1: $conf"
    SF_PORT= SF_SERVER= SF_COMPONENTS= SF_ARGS=
    . "$conf"
    [ -n "$SF_PORT" ] && [ -n "$SF_SERVER" ] && [ -n "$SF_ARGS" ] ||
        die "$conf must set SF_PORT, SF_SERVER and SF_ARGS"
    case "$SF_ARGS" in
        *[\<\>\&]*) die "$conf: SF_ARGS must not contain <, > or &" ;;
    esac
}

# The config of an installed model comes from serve; before install, from
# this script's own checkout.
conf_dir() {
    if [ -d "$(serve_dir "$1")" ]; then serve_dir "$1"; else dirname "$SFDIR"; fi
}

plist_text() {
    m=$1
    serve=$(serve_dir "$m")
    load_conf "$m" "$(conf_dir "$m")"
    cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Written by sfctl from sfctl/sf-$m.conf: edit that file and run sfctl update $m. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>$(label "$m")</string>
  <key>ProgramArguments</key>
  <array>
    <string>$serve/$SF_SERVER</string>
    <string>--port</string>
    <string>$SF_PORT</string>
EOF
    for a in $SF_ARGS; do
        case $a in
            *@HOME@*) a="$(home_dir "$m")${a#*@HOME@}" ;;
        esac
        echo "    <string>$a</string>"
    done
    cat <<EOF
  </array>
  <key>WorkingDirectory</key>
  <string>$serve</string>
  <key>RunAtLoad</key>
  <false/>
  <key>KeepAlive</key>
  <false/>
  <key>StandardOutPath</key>
  <string>$LOGS/$m.out.log</string>
  <key>StandardErrorPath</key>
  <string>$LOGS/$m.err.log</string>
</dict>
</plist>
EOF
}

write_plist() {
    mkdir -p "$LA" "$LOGS" "$(home_dir "$1")/kv"
    plist_text "$1" >"$(plist_path "$1").tmp"
    plutil -lint -s "$(plist_path "$1").tmp" || die "generated agent for $1 is not a valid plist"
    mv "$(plist_path "$1").tmp" "$(plist_path "$1")"
}

# Links each component whose path is missing in serve (load_conf first).
link_components() {
    serve=$1
    for c in $SF_COMPONENTS; do
        [ -e "$serve/${c#*:}" ] && continue
        (cd "$serve" && ./download.sh "${c%%:*}") || die "./download.sh ${c%%:*} failed in $serve"
    done
}

build() {
    make -C "$1" "$SF_SERVER" || die "build failed in $1 at $(git -C "$1" rev-parse --short HEAD); the service is not started"
}

wait_exit() {
    i=0
    while kill -0 "$1" 2>/dev/null; do
        i=$((i + 1))
        [ "$i" -le 120 ] || die "pid $1 still running after 120 s"
        sleep 1
    done
}

# One engine at a time: another sfctl service, or any process holding an
# engine instance lock (manual runs, upstream ds4). The engine's own flock
# still decides a race between two starts.
exclusion_check() {
    for o in $(running_models); do
        [ "$o" = "$1" ] && continue
        die "$o is running (pid $(pid "$o")); stop it first: sfctl stop $o"
    done
    holders=$(lsof -t /tmp/ds4.lock /tmp/sf-*.lock 2>/dev/null | sort -u | tr '\n' ' ')
    if [ -n "$holders" ]; then
        for p in $holders; do
            echo "sfctl: pid $p ($(ps -o comm= -p "$p" 2>/dev/null)) holds an engine instance lock" >&2
        done
        die "stop that engine before starting $1"
    fi
}

boost_check() {
    case " $SF_ARGS " in
        *" --boost"*)
            "$FANBOOST" check || die "$1 asks for boost, and fanboost check failed: install or restart it with ./fanboost/install.sh (see fanboost/README.md)"
            ;;
    esac
}

cmd_start() {
    need_installed "$1"
    p=$(pid "$1")
    if [ -n "$p" ]; then
        echo "$1 already running (pid $p)"
        return
    fi
    load_conf "$1" "$(serve_dir "$1")"
    exclusion_check "$1"
    boost_check "$1"
    mkdir -p "$LOGS"
    loaded "$1" || launchctl bootstrap "$DOMAIN" "$(plist_path "$1")"
    launchctl kickstart -k "$(target "$1")"
    echo "$1 starting on 127.0.0.1:$SF_PORT; watch the load with: sfctl follow $1"
}

cmd_stop() {
    need_installed "$1"
    p=$(pid "$1")
    if [ -z "$p" ]; then
        echo "$1 is not running"
        return
    fi
    launchctl kill SIGTERM "$(target "$1")"
    wait_exit "$p"
    echo "$1 stopped"
}

status_line() {
    m=$1
    serve=$(serve_dir "$m")
    p=$(pid "$m")
    state="stopped"
    [ -n "$p" ] && state="running pid $p"
    if [ ! -d "$serve" ]; then
        echo "$m $state, serve missing ($serve)"
        return
    fi
    port=$( (load_conf "$m" "$serve" && echo "$SF_PORT") 2>/dev/null || echo "?")
    cur=$(git -C "$serve" rev-parse --short HEAD)
    main=$(git -C "$serve" rev-parse --short main)
    if [ "$cur" = "$main" ]; then
        sync="serve $cur = main"
    elif git -C "$serve" merge-base --is-ancestor HEAD main; then
        sync="serve $cur behind main $main (sfctl update $m)"
    else
        sync="serve $cur differs from main $main"
    fi
    echo "$m $state port $port, $sync"
}

cmd_status() {
    if [ -n "${1:-}" ]; then
        need_installed "$1"
        status_line "$1"
        return
    fi
    models=$(installed_models)
    [ -n "$models" ] || {
        echo "no sfctl service installed"
        return
    }
    for m in $models; do status_line "$m"; done
}

cmd_install() {
    root=$(git -C "$SFDIR" rev-parse --show-toplevel)
    m=${1:-}
    if [ -z "$m" ]; then
        set -- "$SFDIR"/sf-*.conf
        [ $# -eq 1 ] && [ -e "$1" ] || die "install needs a model: no single sfctl/sf-*.conf in $SFDIR"
        m=${1##*/sf-}
        m=${m%.conf}
    fi
    serve=$(serve_dir "$m")
    [ ! -e "$serve" ] || die "$serve exists; to sync it with main run: sfctl update $m"
    git -C "$root" cat-file -e "main:sfctl/sf-$m.conf" 2>/dev/null ||
        die "main has no sfctl/sf-$m.conf: merge the change into main first"
    mkdir -p "$(home_dir "$m")"
    git -C "$root" worktree add --detach "$serve" main
    load_conf "$m" "$serve"
    build "$serve"
    link_components "$serve"
    write_plist "$m"
    mkdir -p "$(dirname "$CMD_LINK")"
    if [ ! -e "$CMD_LINK" ] && [ ! -L "$CMD_LINK" ]; then
        ln -s "$serve/sfctl/sfctl" "$CMD_LINK"
    elif [ -L "$CMD_LINK" ]; then
        case $(readlink "$CMD_LINK") in
            "$HOME"/.sf/*/serve/*) ln -sfn "$serve/sfctl/sfctl" "$CMD_LINK" ;;
            *) echo "sfctl: $CMD_LINK points elsewhere; left alone" >&2 ;;
        esac
    else
        echo "sfctl: $CMD_LINK is not a link; left alone" >&2
    fi
    echo "$m installed at $(git -C "$serve" rev-parse --short HEAD); start it with: sfctl start $m"
}

cmd_update() {
    m=$1
    need_installed "$m"
    serve=$(serve_dir "$m")
    [ -d "$serve" ] || die "$serve is missing; uninstall and install $m again"
    dirty=$(git -C "$serve" status --porcelain)
    [ -z "$dirty" ] || die "serve has local modifications, nothing stopped:
$dirty"
    old=$(git -C "$serve" rev-parse --short HEAD)
    was=$(pid "$m")
    if [ -n "$was" ]; then
        launchctl kill SIGTERM "$(target "$m")"
        wait_exit "$was"
        echo "$m stopped for the update"
    fi
    git -C "$serve" checkout --quiet --detach main
    load_conf "$m" "$serve"
    build "$serve"
    link_components "$serve"
    ! loaded "$m" || launchctl bootout "$(target "$m")"
    write_plist "$m"
    [ -z "$was" ] || cmd_start "$m"
    new=$(git -C "$serve" rev-parse --short HEAD)
    echo "$m serve $old..$new"
    git -C "$serve" log --oneline "$old..$new"
}

cmd_uninstall() {
    m=$1
    need_installed "$m"
    serve=$(serve_dir "$m")
    [ -z "$(pid "$m")" ] || cmd_stop "$m"
    ! loaded "$m" || launchctl bootout "$(target "$m")"
    rm -f "$(plist_path "$m")"
    if [ -d "$serve" ]; then
        git -C "$serve" worktree remove "$serve" ||
            die "git refused to remove $serve (local modifications?); the agent is already gone"
    fi
    if [ -L "$CMD_LINK" ]; then
        case $(readlink "$CMD_LINK") in
            "$serve"/*)
                rm -f "$CMD_LINK"
                for o in $(installed_models); do
                    ln -s "$(serve_dir "$o")/sfctl/sfctl" "$CMD_LINK"
                    break
                done
                ;;
        esac
    fi
    echo "$m uninstalled; kept $(home_dir "$m")/kv, $LOGS and the model cache"
}

[ $# -ge 1 ] || usage
cmd=$1
shift
model=${1:-}
case $cmd in
    install) cmd_install "$model" ;;
    status) cmd_status "$model" ;;
    update | start | stop | restart | logs | follow | plist | uninstall)
        need_model "$cmd" "$model"
        case $cmd in
            update) cmd_update "$model" ;;
            start) cmd_start "$model" ;;
            stop) cmd_stop "$model" ;;
            restart)
                cmd_stop "$model"
                cmd_start "$model"
                ;;
            logs)
                need_installed "$model"
                tail -n "${2:-80}" "$LOGS/$model.out.log" "$LOGS/$model.err.log"
                ;;
            follow)
                need_installed "$model"
                tail -F "$LOGS/$model.out.log" "$LOGS/$model.err.log"
                ;;
            plist)
                [ -d "$(serve_dir "$model")" ] || [ -f "$SFDIR/sf-$model.conf" ] ||
                    die "$model is not installed and $SFDIR has no sf-$model.conf"
                plist_text "$model"
                ;;
            uninstall) cmd_uninstall "$model" ;;
        esac
        ;;
    -h | --help | help) usage ;;
    *)
        echo "sfctl: unknown command: $cmd" >&2
        usage
        ;;
esac
