DS4_ENV(DS4_TEST_TP_RDMA_DEVICE, test, any, "Session batch TP test: RDMA device name")
DS4_ENV(DS4_TEST_TP_TRANSPORT, test, any, "Session batch TP test: transport auto, tcp or rdma")
DS4_ENV(DS4_TEST_VECTOR_FILE, test, any, "Tensor-equivalence tests: test-vector file (default tests/test-vectors/flash-0731/official.vec)")
DS4_ENV(DS4_THREADS, tuning, unset, "CPU worker pool threads (default min(online CPUs, 12)); the threads option overrides it")
DS4_ENV(DS4_TOKEN_TIMING, probe, unset, "CPU generate loop: print per-token eval timing to stderr")
DS4_ENV(DS4_TP_ABLATE, probe, unset, "TP profiling: skip listed chains (hcpre, router, kv, compidx); output wrong, set on both ranks")
DS4_ENV(DS4_TP_BIG_GATE_DEBUG, probe, unset, "TP RDMA: log verify-window arm/close and big-gate exchange timings to stderr")
DS4_ENV(DS4_TP_BIG_GATE_SPIN_US, tuning, unset, "TP big-gate wait: sleep-poll interval in us (default 20, 0 = tight spin, max 5000)")
DS4_ENV(DS4_TP_DISABLE_FLAG_FOLD, disable, unset, "TP: turn off folding the gate flag check into the partial-sum add kernel")
DS4_ENV(DS4_TP_DISABLE_GATE_PREFETCH, disable, unset, "TP: turn off weight prefetch during gate exchange waits")
DS4_ENV(DS4_TP_DISABLE_POLL_GATES, disable, unset, "TP: turn off polled flag gates and use the shared-event wait")
DS4_ENV(DS4_TP_DISABLE_RDMA_WARMUP, disable, unset, "TP RDMA: skip the link warm-up after the ready barrier")
DS4_ENV(DS4_TP_DISABLE_VERIFY_WINDOW, disable, unset, "TP RDMA: turn off the pre-posted batch block window, keeping per-gate handshakes")
DS4_ENV(DS4_TP_EVENT_GATES, disable, unset, "TP: turn off slab-flag gate arrival and use the shared-event arrival path")
DS4_ENV(DS4_TP_FOLD_DEBUG, probe, unset, "TP: log the first 8 flag-fold requests and takes with their eligibility to stderr")
DS4_ENV(DS4_TP_GATE_PROFILE, probe, unset, "TP: gate exchange and service-thread timing statistics")
DS4_ENV(DS4_TP_GATE_TIMEOUT_MS, tuning, unset, "TP per-gate exchange timeout in ms (1-60000, default built in)")
DS4_ENV(DS4_TP_GATE_TRACE, probe, unset, "TP RDMA: print every gate exchange layer, gate and sequence to stderr")
DS4_ENV(DS4_TP_KEEPALIVE_ITERS, tuning, unset, "GPU keep-alive kernel loop iterations (default 1200000, 4000 in burst mode)")
DS4_ENV(DS4_TP_KEEPALIVE_TGS, tuning, unset, "GPU keep-alive kernel threadgroups (default 1, max 2048)")
DS4_ENV(DS4_TP_NO_KEEPALIVE, disable, unset, "TP: do not start the GPU keep-alive queue and thread")
DS4_ENV(DS4_TP_PREFETCH_BYTES_PER_US, tuning, unset, "TP gate prefetch: assumed bytes per us when sizing prefetch from the wait (default built in)")
DS4_ENV(DS4_TP_PREFETCH_MARGIN_US, tuning, unset, "TP gate prefetch: us subtracted from the expected wait before sizing prefetch (0-1000)")
DS4_ENV(DS4_TP_PREFILL_SPLIT_MIN, tuning, unset, "TP prefill: minimum batch rows to row-split the shared expert (default 32, min 2)")
DS4_ENV(DS4_TP_SHARED_SPLIT_SHIFT_Q16, tuning, unset, "TP decode: shared-expert split shift in Q16 (default from expert sizes, 0 = fixed halves)")
DS4_ENV(DS4_TP_STATIC_SHARED_SPLIT, disable, unset, "TP decode: keep fixed shared-expert halves instead of the measured GPU-decided split")
DS4_ENV(DS4_TP_TIMEOUT_SEC, tuning, unset, "TP control and data socket timeout in seconds (default built in)")
DS4_ENV(DS4_TRACE_TOP, probe, unset, "CPU generate loop: print the top 10 logits at each step to stderr")
