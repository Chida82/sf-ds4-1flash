/* sf: every DS4_* environment variable the sources read, one line each, sorted.
 * DS4_ENV(name, category, normal-use state, "what it does, from its read site")
 * Categories: operational (paths, lock, replica: set on purpose), tuning (knob
 * with a measured default), disable (turns a speed-up off), enable (opt-in
 * experiment), probe (timing, profiles, dumps, debug), test (tests and test
 * hooks). State: any for operational and test, unset for the rest.
 * ds4_env.h turns this into the startup report's table; `make env-check`
 * fails on a read name missing here or a line nothing reads any more. */
DS4_ENV(DS4_ALLOW_V41_STEERING, enable, unset, "Opt into V4.1 directional steering: lift the --dir-steering-file startup refusal (single-box Metal only)")
DS4_ENV(DS4_BATCHED_FFN, enable, unset, "CPU reference prefill: opt into batched routed FFN across tokens")
DS4_ENV(DS4_BATCHED_ROPE_MAX, tuning, unset, "CPU reference prefill: max tokens for batched prefix RoPE (default 4096, 0-65536)")
DS4_ENV(DS4_BENCH_DISABLE_SNAPSHOT, disable, unset, "Bench: skip session snapshot/restore after generation and replay prefixes instead")
DS4_ENV(DS4_BENCH_FORCE_SNAPSHOT, enable, unset, "Bench: take session snapshots even above the snapshot size limit")
DS4_ENV(DS4_BENCH_SNAPSHOT_MAX_BYTES, tuning, unset, "Bench: largest session snapshot to use, bytes or unlimited/inf (default 1 GiB)")
DS4_ENV(DS4_CLI_FORCE_SESSION, probe, unset, "CLI: force the sampled session path for greedy runs, to compare TP and single-node like with like")
DS4_ENV(DS4_CPU_DISABLE_UNROLLED_ARGMAX, disable, unset, "Use the plain argmax loop instead of the 8-way unrolled argmax over the logits")
DS4_ENV(DS4_CPU_DUMP_PREFILL_LOGITS, probe, unset, "CPU reference generate: write post-prefill logits as raw f32 to this path")
DS4_ENV(DS4_CUDA_NO_COMPRESSOR_PREFILL_BATCH, disable, unset, "Layer-slice graph prefill: run compressor/indexer per token instead of one aligned batch")
DS4_ENV(DS4_DECODE_PROFILE_DETAIL, probe, unset, "CPU reference decode: time each layer stage (HC, norm, attention, routed, shared) and print it")
DS4_ENV(DS4_DEEPSEEK4_VISION_DEBUG_PREFIX, probe, unset, "Vision encoder: dump intermediate tensors to files with this path prefix")
DS4_ENV(DS4_DIST_CONNECT_BIND_HOST, operational, any, "Distributed: local address to bind outgoing connections to")
DS4_ENV(DS4_DIST_CONNECT_BIND_IF, operational, any, "Distributed: network interface to bind outgoing connections to")
DS4_ENV(DS4_DIST_CONNECT_TRACE, probe, unset, "Distributed: trace connection attempts, addresses and errors")
DS4_ENV(DS4_DIST_DECODE_PROFILE, probe, unset, "Distributed: print per-token decode timing breakdown")
DS4_ENV(DS4_DIST_DISABLE_PREFILL_ACK_ONLY, disable, unset, "Distributed prefill: request full results for every chunk instead of ack-only for non-final chunks")
DS4_ENV(DS4_DIST_DISABLE_PREFILL_PIPELINE, disable, unset, "Distributed: disable pipelined chunked prefill across the route")
DS4_ENV(DS4_DIST_DISABLE_WORKER_PREFETCH, disable, unset, "Distributed worker: use the plain read loop instead of the prefetching one")
DS4_ENV(DS4_DIST_PREFILL_CHUNK, tuning, unset, "Distributed prefill chunk tokens when not set by option (default prefill capacity)")
DS4_ENV(DS4_DIST_PREFILL_SEND_DEPTH, tuning, unset, "Distributed prefill sender queue depth (default 2, 1-8)")
DS4_ENV(DS4_DIST_PREFILL_WINDOW, tuning, unset, "Distributed prefill chunks in flight (default remote stages + 2, clamped 2-8; max 64)")
DS4_ENV(DS4_DIST_SOCKET_BUFFER_MB, tuning, unset, "Distributed socket send/receive buffer size in MiB (default 128, 0-512, 0 keeps system default)")
DS4_ENV(DS4_DIST_SOCKET_RECV_TIMEOUT_SEC, tuning, unset, "Distributed socket receive timeout in seconds (default none, 1-3600)")
DS4_ENV(DS4_DIST_SOCKET_TIMEOUT_SEC, tuning, unset, "Distributed socket send timeout in seconds (default 60, 1-3600)")
DS4_ENV(DS4_DIST_WORKER_FORWARD_WINDOW, tuning, unset, "Distributed worker forward window depth (default 4, 1-64)")
DS4_ENV(DS4_DIST_WORKER_PREFETCH_DEPTH, tuning, unset, "Distributed worker read prefetch depth (default 2, 1-8)")
DS4_ENV(DS4_EXPERT_HOTLIST, probe, unset, "Metal expert locality profiler: write a ranked expert hotlist to this path")
DS4_ENV(DS4_EXPERT_PROFILE, probe, unset, "Metal expert locality profiler: write the profile JSON to this path (if no option given)")
DS4_ENV(DS4_GLM_LOGIT_DUMP, probe, unset, "Write the post-prefill logits once as raw f32 to this path")
DS4_ENV(DS4_GLM_MEMORY_GUARD_REPORT, probe, unset, "SSD streaming startup: print the largest active model group size")
DS4_ENV(DS4_GLM_TP_DEBUG, probe, unset, "Print why routed MoE kernels returned early and TP exchange debug ids")
DS4_ENV(DS4_LOCK_FILE, operational, any, "Instance lock file path (default /tmp/sf-ds4-1flash.lock)")
DS4_ENV(DS4_METAL_ARGSORT_SOURCE, probe, unset, "Load argsort.metal from this path instead of the built-in source")
DS4_ENV(DS4_METAL_ATTN_OUT_STAGE_PROFILE, probe, unset, "Time the attention output stage in its own command buffer")
DS4_ENV(DS4_METAL_BIN_SOURCE, probe, unset, "Load bin.metal from this path instead of the built-in source")
DS4_ENV(DS4_METAL_CB_TIMES, probe, unset, "Print Metal command buffer encode, queue-wait and GPU times, and bench prefill windows")
DS4_ENV(DS4_METAL_COMPRESSOR_PAIR_NR4, enable, unset, "Use 4 rows per simdgroup in the compressor pair f16 matvec (out 512/1024, in >= 4096)")
DS4_ENV(DS4_METAL_CONCAT_SOURCE, probe, unset, "Load concat.metal from this path instead of the built-in source")
DS4_ENV(DS4_METAL_CPY_SOURCE, probe, unset, "Load cpy.metal from this path instead of the built-in source")
DS4_ENV(DS4_METAL_DECODE_STAGE_PROFILE, probe, unset, "Profile decode per layer stage; also turns off layer batching and batched session decode")
DS4_ENV(DS4_METAL_DECODE_STAGE_PROFILE_LAYER, probe, unset, "Limit the decode stage profile to this layer")
DS4_ENV(DS4_METAL_DEEPSEEK4_VISION_SOURCE, probe, unset, "Load deepseek4_vision.metal from this path instead of the built-in source")
DS4_ENV(DS4_METAL_DENSE_SOURCE, probe, unset, "Load dense.metal from this path instead of the built-in source")
DS4_ENV(DS4_METAL_DISABLE_AFFINE_ROPE_PAIR, disable, unset, "Turn off the affine in-place RoPE pair decode kernel and the fusions built on it")
DS4_ENV(DS4_METAL_DISABLE_ATTN_OUT_HC_FUSION, disable, unset, "Layer-slice graph decode: reference attention output plus HC expand instead of the fused one")
DS4_ENV(DS4_METAL_DISABLE_ATTN_OUT_IDS_CACHE, disable, unset, "Allocate attention output group ids per call instead of reusing a scratch buffer")
DS4_ENV(DS4_METAL_DISABLE_ATTN_OUT_LOW_DIRECT, disable, unset, "Turn off the direct low-rank attention output path for batches under 32 tokens")
DS4_ENV(DS4_METAL_DISABLE_BATCH_HC_NORM_FUSION, disable, unset, "Layer-slice graph batch: turn off the fused HC norm in attention and FFN batches")
DS4_ENV(DS4_METAL_DISABLE_COMPRESSOR_APE_ADD, disable, unset, "M3: compute compressor score and APE add separately instead of the fused kernel")
DS4_ENV(DS4_METAL_DISABLE_COMPRESSOR_PAIR_PROJ, disable, unset, "Turn off the fused compressor KV/score pair projection and store kernel")
DS4_ENV(DS4_METAL_DISABLE_COMPRESSOR_RATIO4_DIRECT_POOL, disable, unset, "M3: turn off the direct ratio-4 compressor softmax pool kernel")
DS4_ENV(DS4_METAL_DISABLE_COMPRESSOR_RATIO4_PACK_FUSION, disable, unset, "M3: turn off the fused ratio-4 compressor pack kernel")
DS4_ENV(DS4_METAL_DISABLE_COMPRESSOR_STORE_ONE, disable, unset, "Store compressor state with the generic path instead of the one-dispatch store kernel")
DS4_ENV(DS4_METAL_DISABLE_CONTIG_F16_F16_COPY, disable, unset, "Use the generic f16 copy kernel instead of the contiguous vectorised one; blocks gathered KV stage")
DS4_ENV(DS4_METAL_DISABLE_CONTIG_F32_F16_COPY, disable, unset, "Use generic f32/f16 conversion copies instead of contiguous vectorised ones; blocks gathered KV stage")
DS4_ENV(DS4_METAL_DISABLE_GATHERED_KV_PAD_FUSION, disable, unset, "Turn off the KV padding fused into the gathered KV staging kernel")
DS4_ENV(DS4_METAL_DISABLE_GATHERED_KV_STAGE, disable, unset, "Turn off the gathered KV staging kernel and the attention staged with its gather")
DS4_ENV(DS4_METAL_DISABLE_HC_EXPAND_PRODUCER_FUSE, disable, unset, "Layer-slice graph decode, M5 TP2 resident: turn off HC expand fused into its producer")
DS4_ENV(DS4_METAL_DISABLE_HC_FUSION, disable, unset, "Layer-slice graph: use the reference HC pre/post path instead of the fused one")
DS4_ENV(DS4_METAL_DISABLE_HC_NORM_FUSION, disable, unset, "Layer-slice graph: use the reference HC norm instead of the fused one (also batch fusion)")
DS4_ENV(DS4_METAL_DISABLE_HC_RMS_SCALE_PROJ, disable, unset, "Turn off the fused HC RMS-scale projection kernel")
DS4_ENV(DS4_METAL_DISABLE_HOT_PIPELINE_STATICS, disable, unset, "Look up hot Metal pipelines by name each call instead of caching them in statics")
DS4_ENV(DS4_METAL_DISABLE_INPLACE_ROPE_PAIR, disable, unset, "Turn off the in-place RoPE pair kernels and the decode fusions built on them")
DS4_ENV(DS4_METAL_DISABLE_IQ2_SELECTED_EXPERT_VIEWS, disable, unset, "Turn off IQ2 selected-expert slot kernels for streaming decode MoE")
DS4_ENV(DS4_METAL_DISABLE_IQ2_SELECTED_SHARED_OVERLAP, disable, unset, "Layer-slice graph streaming decode: do not overlap shared expert with selected expert loads")
DS4_ENV(DS4_METAL_DISABLE_IQ2_STREAM_ADDR_TABLE, disable, unset, "Turn off the IQ2 streaming expert address-table kernels in decode and prefill")
DS4_ENV(DS4_METAL_DISABLE_KV_FUSION, disable, unset, "Layer-slice graph decode: use the reference KV store instead of the fused one")
DS4_ENV(DS4_METAL_DISABLE_KV_NORM_DEFER, disable, unset, "Layer-slice graph decode, TP2: keep the standalone KV norm instead of folding it into KV staging")
DS4_ENV(DS4_METAL_DISABLE_M3_ULTRA_GLM53_BF16_NSG4, disable, unset, "M3 Ultra: vision BF16 matvec uses 8 simdgroups instead of 4")
DS4_ENV(DS4_METAL_DISABLE_M3_ULTRA_GLM53_DECODE, disable, unset, "M3 Ultra: vision BF16 matvec uses 8 simdgroups instead of 4")
DS4_ENV(DS4_METAL_DISABLE_M5_COMPRESSOR_EXACT_POOL_RATIO4, disable, unset, "Turn off the exact ratio-4 compressor pool decode kernel")
DS4_ENV(DS4_METAL_DISABLE_M5_COMP_FINALIZE_FUSE, disable, unset, "Layer-slice graph decode: turn off the fused compressor finalize")
DS4_ENV(DS4_METAL_DISABLE_M5_FLASH_ATTN_PACKED32_REDUCE, disable, unset, "Turn off the packed32 reduce flash-attention decode kernel")
DS4_ENV(DS4_METAL_DISABLE_M5_PACKED_ZERO_MASK, disable, unset, "M5: no persistent zero attention mask on the packed decode attention shape")
DS4_ENV(DS4_METAL_DISABLE_M5_PERSISTENT_ZERO_ATTN_MASK, disable, unset, "M5: build the zero attention mask per call instead of a persistent one")
DS4_ENV(DS4_METAL_DISABLE_M5_Q8_HC_VEC, disable, unset, "M5: use the scalar Q8_0 HC expand4 kernel instead of the 16-byte-aligned vec_hc variant")
DS4_ENV(DS4_METAL_DISABLE_M5_ROUTER_PROJECT_SELECT_FUSE, disable, unset, "M5: run router projection and top-k selection as separate dispatches instead of one fused kernel")
DS4_ENV(DS4_METAL_DISABLE_M5_TP_MXFP4_STATIC, disable, unset, "M5: turn off static-trip MXFP4 MoE decode and TP pair/sum6 kernels for the 256-expert shape")
DS4_ENV(DS4_METAL_DISABLE_M5_TP_PARALLEL_FFN, disable, unset, "M5 TP: run routed and shared-expert FFN branches serially instead of in one concurrent encoder")
DS4_ENV(DS4_METAL_DISABLE_METAL4, disable, unset, "Treat the device as lacking the Metal4 GPU family, so Metal4/TensorOps paths stay off")
DS4_ENV(DS4_METAL_DISABLE_MOE_MM_ID_PAIR_SWIGLU, disable, unset, "Prefill MoE: run gate/up matmuls and SwiGLU separately instead of the fused mm_id pair-SwiGLU kernel")
DS4_ENV(DS4_METAL_DISABLE_MOE_MM_ID_USE_RESOURCES, disable, unset, "Vetoes the opt-in DS4_METAL_MOE_MM_ID_USE_RESOURCES resource hints for MoE mm_id work-map dispatch")
DS4_ENV(DS4_METAL_DISABLE_MXFP4_MM_ID_MPP, disable, unset, "Keep MXFP4 routed experts on simdgroup kernels instead of TensorOps MPP and packed-MPP (TP2) paths")
DS4_ENV(DS4_METAL_DISABLE_MXFP4_SELECTED_EXPERT_VIEWS, disable, unset, "Turn off one-token MXFP4 MoE decode through selected-expert slot views")
DS4_ENV(DS4_METAL_DISABLE_PERSISTENT_ZERO_ATTN_MASK, disable, unset, "Flash attention: fill a scratch mask each call instead of reusing a persistent zero mask (M3/M5)")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_ATTN_INV_ROPE_FUSE, disable, unset, "Decode: run the post-attention inverse RoPE as its own dispatch instead of inside the FA reduce")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_COMPRESSOR_EXACT_POOL_RATIO4, disable, unset, "Pre-M5 decode: turn off the exact ratio-4 compressor pool kernel (M5 has its own switch)")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_COMPRESSOR_EXACT_REDUCTION_FUSION, disable, unset, "Resident decode: turn off the fused exact compressor reduction for ratio-4 8-row updates")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_COMPRESSOR_QUAD_STORE, disable, unset, "Decode: store the four ratio-4 compressor matrices in separate dispatches instead of one quad store")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_COMPRESSOR_RATIO4_DECODE_PACK_FUSION, disable, unset, "Decode: turn off the fused ratio-4 compressor pack kernel")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_COMP_FINALIZE_FUSE, disable, unset, "Pre-M5 decode: turn off the fused compressor finalize (M5 has its own switch)")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_DECODE_EARLY_PIPELINE_FAST_LOOKUP, disable, unset, "Pre-M5 MXFP4 decode: turn off the fast pipeline lookup below position 2048 only")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_DECODE_EARLY_SECOND_SPLIT12, disable, unset, "Decode positions 128-2047: drop the second command-buffer split after layer 12")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_DECODE_EARLY_SPLIT3, disable, unset, "Pre-M5 resident MXFP4 decode 128-2047: keep the 4-layer first split instead of 3")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_DECODE_EARLY_SPLIT5, disable, unset, "Pre-M5 resident MXFP4 decode 2048-2815: keep the 4-layer first split instead of 5")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_DECODE_PIPELINE_FAST_LOOKUP, disable, unset, "Pre-M5 MXFP4 decode: turn off the mirrored fast pipeline lookup at every position")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_DECODE_PORTS, disable, unset, "Pre-M5 only: turn off every M5 decode feature ported to pre-M5 devices, and the Q2 split schedule")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_DECODE_RAW_ZERO_ATTN_MASK, disable, unset, "Pre-M5 resident decode: raw attention uses a scratch mask instead of the persistent zero mask")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_DECODE_SECOND_SPLIT16, disable, unset, "Decode from position 2048: drop the second command-buffer split after layer 16")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_FLASH_ATTN_BATCHED_MEMO, disable, unset, "Turn off the last-pipeline memo for batched flash-attention pipeline lookup")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_FLASH_ATTN_PACKED32_REDUCE, disable, unset, "Pre-M5 decode: turn off the packed 32-workgroup flash-attention reduce (ported M5 feature)")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_FLASH_ATTN_PAD_BLK_MEMO, disable, unset, "Turn off the last-pipeline memo for flash-attention pad and block pipeline lookups")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_HEAD_RMS_ROPE_PIPELINE_STATIC, disable, unset, "Pre-M5 resident: turn off the static head RMS-norm + RoPE tail pipeline")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_KV_ROPE_FP8_FUSE, disable, unset, "Pre-M5 decode: run KV RoPE and FP8 store separately instead of the fused kernel")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_MXFP4_MM_ID_PAIR_HALF_SCALE, disable, unset, "Pre-M5 resident prefill: MXFP4 mm_id pair-SwiGLU keeps float scales instead of half scales")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_MXFP4_MOE_DECODE_NSG1, disable, unset, "Pre-M5 MXFP4 one-token decode: turn off the nsg=1 MoE kernel variants")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_MXFP4_MOE_DECODE_TG_MULTIPLE, disable, unset, "Pre-M5 MXFP4 decode: turn off exact 32-thread dispatch (gates all fixed-route MoE kernels)")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_MXFP4_MOE_MM_ID_DOWN_HALF_LUT, disable, unset, "Pre-M5 prefill of 2048+ tokens: turn off the half-LUT MXFP4 mm_id down projection")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_MXFP4_MOE_MM_ID_DOWN_TAIL_SIMDGROUP_CULL, disable, unset, "Pre-M5 resident prefill 2048+: turn off tail simdgroup culling in the MXFP4 mm_id down kernel")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_MXFP4_MOE_MM_ID_MAP_SCATTER, disable, unset, "Pre-M5 prefill 2048+: turn off the scatter-built MXFP4 mm_id work map")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_MXFP4_MOE_MM_ID_PAIR_SWIGLU_COMPACT_TILE, disable, unset, "Pre-M5 resident prefill 2048+: turn off the compact 32x32 MXFP4 pair-SwiGLU tile")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_MXFP4_MOE_MM_ID_PAIR_TAIL_SIMDGROUP_CULL, disable, unset, "Pre-M5 resident prefill 2048+: turn off tail simdgroup culling in MXFP4 pair-SwiGLU")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_QKV_NORM_KV_STORE_FUSE, disable, unset, "Decode: turn off folding the KV norm and store into the fused QKV norm kernel")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_ROUTER_SHARED_FUSE, disable, unset, "Pre-M5 decode: turn off the fused router + shared-expert FFN path")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_ROUTER_SIMD_FINALIZE, disable, unset, "Pre-M5 one-token router: use the scalar finalize instead of the SIMD finalize kernel")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_ROUTER_SIMD_WEIGHTS_FUSION, disable, unset, "Pre-M5 one-token router: turn off fusing expert weights into the SIMD finalize")
DS4_ENV(DS4_METAL_DISABLE_PRE_M5_ROUTER_TRANSFORM_FINALIZE_FUSION, disable, unset, "Resident one-token router: turn off the fused transform + finalize kernel")
DS4_ENV(DS4_METAL_DISABLE_PRO_Q4_EXPERT_ADDRESS_AUTO, disable, unset, "Q4 GGUF: turn off the automatic expert address-table decode path")
DS4_ENV(DS4_METAL_DISABLE_PRO_Q4_EXPERT_TABLE_AUTO, disable, unset, "Q4 GGUF: turn off the automatic expert-table decode path (streaming or opted-in resident)")
DS4_ENV(DS4_METAL_DISABLE_Q4_BATCH_EXPERT_TABLE, disable, unset, "Q4 GGUF batches: turn off the batched expert-table MoE path")
DS4_ENV(DS4_METAL_DISABLE_Q4_EXACT_BOUNDARY, disable, unset, "Q4 exact-tensor-id path: skip the command-buffer boundary around each layer")
DS4_ENV(DS4_METAL_DISABLE_Q4_EXACT_TENSOR_ID, disable, unset, "Vetoes the opt-in Q4 exact-tensor-id MoE decode path (DS4_METAL_ENABLE_Q4_EXACT_TENSOR_ID)")
DS4_ENV(DS4_METAL_DISABLE_Q4_EXPERT_ADDRESS_TABLE, disable, unset, "Q4 GGUF: turn off the expert address-table MoE decode path, auto or opted in")
DS4_ENV(DS4_METAL_DISABLE_Q4_EXPERT_TABLE, disable, unset, "Q4 GGUF: turn off every expert-table MoE path (single-token, batch and auto)")
DS4_ENV(DS4_METAL_DISABLE_Q4_GATHER_SLOTS, disable, unset, "Vetoes the opt-in Q4 gather-slots MoE decode path (DS4_METAL_ENABLE_Q4_GATHER_SLOTS)")
DS4_ENV(DS4_METAL_DISABLE_Q4_GROUP24_EXPERT_TABLE, disable, unset, "Vetoes the opt-in Q4 group-24 expert-table decode path")
DS4_ENV(DS4_METAL_DISABLE_Q4_GROUP6_EXPERT_TABLE, disable, unset, "Vetoes the opt-in Q4 group-6 expert-table decode path")
DS4_ENV(DS4_METAL_DISABLE_Q4_GROUP8_EXPERT_TABLE, disable, unset, "Vetoes the opt-in Q4 group-8 expert-table decode path")
DS4_ENV(DS4_METAL_DISABLE_Q4_GROUPED_BOUNDARY, disable, unset, "Q4 grouped-experts path: skip the command-buffer boundary around each layer")
DS4_ENV(DS4_METAL_DISABLE_Q4_GROUPED_EXPERTS, disable, unset, "Vetoes the opt-in Q4 grouped-experts decode path (DS4_METAL_ENABLE_Q4_GROUPED_EXPERTS)")
DS4_ENV(DS4_METAL_DISABLE_Q4_K_MM_ID_MPP, disable, unset, "Keep Q4_K routed gate/up prefill on simdgroup kernels instead of the TensorOps MPP kernel")
DS4_ENV(DS4_METAL_DISABLE_Q4_MV_CLASSIC, disable, unset, "Dense Q4_K matvec: use the ext kernel instead of the classic dense kernel")
DS4_ENV(DS4_METAL_DISABLE_Q4_SELECTED_EXPERT_VIEWS, disable, unset, "Q4 GGUF decode: turn off the selected-expert slot views path")
DS4_ENV(DS4_METAL_DISABLE_Q4_TABLE_BOUNDARY, disable, unset, "Q4 expert table with residency set: skip the per-layer command-buffer boundary")
DS4_ENV(DS4_METAL_DISABLE_QKV_NORM_FUSION, disable, unset, "Decode: use the reference unfused QKV norm instead of the fused kernel")
DS4_ENV(DS4_METAL_DISABLE_QUEUE_KEEPALIVE, disable, unset, "Stop the 1 Hz idle-queue keepalive kernel that keeps GPU mappings warm (avoids a 600-800 ms stall)")
DS4_ENV(DS4_METAL_DISABLE_QUEUE_RESIDENCY_SET, disable, unset, "Do not attach the model-view residency set to the command queue")
DS4_ENV(DS4_METAL_DISABLE_ROUTED_MPP_PACKED, disable, unset, "Prefill MoE: turn off the packed TensorOps MPP routed-expert path")
DS4_ENV(DS4_METAL_DISABLE_ROUTED_PAIR_SWIGLU_FUSION, disable, unset, "MoE: run routed gate/up and SwiGLU unfused; also turns off every selected/addr-table fast path")
DS4_ENV(DS4_METAL_DISABLE_ROUTER_SELECT_FUSION, disable, unset, "Router: turn off fused top-k select/finalize for decode and the batch weights fusion")
DS4_ENV(DS4_METAL_DISABLE_ROUTER_WEIGHTS_BATCH_FUSION, disable, unset, "M3 multi-token router: turn off the fused batch expert-weights kernel")
DS4_ENV(DS4_METAL_DISABLE_SHARED_DOWN_HC_FUSION, disable, unset, "Decode: use the reference shared-expert down then HC expand instead of the fused kernel")
DS4_ENV(DS4_METAL_DISABLE_SHARED_KV_PAD, disable, unset, "M3 flash attention: turn off the shared-memory KV pad for partial key blocks")
DS4_ENV(DS4_METAL_DISABLE_SHARED_ROPE_COEFF, disable, unset, "In-place RoPE pair: turn off the shared4 coefficient kernel for batches of 32+ tokens")
DS4_ENV(DS4_METAL_DISABLE_STREAMING_CACHE_LOCK_AHEAD, disable, unset, "SSD streaming: lock expert cache slots as the first prefill seeds them instead of all at engine open")
DS4_ENV(DS4_METAL_DISABLE_STREAMING_COMPACT_ADDR, disable, unset, "Vetoes the opt-in compact expert address table for SSD streaming")
DS4_ENV(DS4_METAL_DISABLE_STREAMING_EXPERT_ADDR_TABLE, disable, unset, "SSD streaming: turn off expert address tables (prefill batch selected addr, compact, split paths)")
DS4_ENV(DS4_METAL_DISABLE_STREAMING_EXPERT_COMBINED_BUFFER, disable, unset, "SSD streaming: turn off the combined expert cache buffer and with it the slab cache")
DS4_ENV(DS4_METAL_DISABLE_STREAMING_EXPERT_EARLY_LOAD, disable, unset, "SSD streaming: do not start loading missing selected experts early")
DS4_ENV(DS4_METAL_DISABLE_STREAMING_EXPERT_EVICT_DONTNEED, disable, unset, "Vetoes the opt-in posix_madvise DONTNEED on evicted streamed expert ranges")
